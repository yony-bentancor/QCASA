{% extends 'qcasa/layout.njk' %}{% block qcbody %}
<main class="qc-search-page qc-public-surface"><section class="qc-search-head qc-search-head-premium"><div class="qc-search-title-row"><div><span class="qc-kicker">PROPIEDADES</span><h1>{% if filters.operation=='Alquiler' %}Alquilá tu próximo lugar{% elif filters.operation=='Venta' %}Comprá tu próximo lugar{% else %}Encontrá la indicada{% endif %}</h1><p class="qc-search-context">{% if filters.operation=='Alquiler' %}Propiedades disponibles para alquilar{% elif filters.operation=='Venta' %}Propiedades disponibles para comprar{% else %}Buscá por zona, tipo, precio o características{% endif %}</p></div></div>
<form action="/qcasa/buscar" method="get" class="qc-filters qc-filters-primary"><input name="q" value="{{ filters.q or '' }}" placeholder="Zona o palabra clave"><select name="operation"><option value="">Operación</option><option value="Venta" {% if filters.operation=='Venta' %}selected{% endif %}>Venta</option><option value="Alquiler" {% if filters.operation=='Alquiler' %}selected{% endif %}>Alquiler</option></select><select name="category"><option value="">Tipo</option>{% for c in categories %}<option value="{{ c }}" {% if filters.category==c %}selected{% endif %}>{{ c }}</option>{% endfor %}</select><select name="department"><option value="">Departamento</option>{% for d in departments %}<option value="{{ d }}" {% if filters.department==d %}selected{% endif %}>{{ d }}</option>{% endfor %}</select><button>Buscar</button><button type="button" class="qc-more-filters" id="qcMoreFilters">Más filtros +</button>
<div class="qc-advanced-filters {% if advancedActive %}is-open{% endif %}" id="qcAdvancedFilters"><label>Precio mínimo<input type="number" name="minPrice" value="{{ filters.minPrice or '' }}"></label><label>Precio máximo<input type="number" name="maxPrice" value="{{ filters.maxPrice or '' }}"></label><label>Dormitorios<select name="bedrooms"><option value="">Cualquiera</option>{% for n in [1,2,3,4,5] %}<option value="{{ n }}" {% if filters.bedrooms==n %}selected{% endif %}>{{ n }}+</option>{% endfor %}</select></label><label>Baños<select name="bathrooms"><option value="">Cualquiera</option>{% for n in [1,2,3,4] %}<option value="{{ n }}" {% if filters.bathrooms==n %}selected{% endif %}>{{ n }}+</option>{% endfor %}</select></label><label>Superficie mínima<input type="number" name="minArea" value="{{ filters.minArea or '' }}" placeholder="m²"></label><label>Superficie máxima<input type="number" name="maxArea" value="{{ filters.maxArea or '' }}" placeholder="m²"></label><label class="qc-check-filter"><input type="checkbox" name="garage" value="1" {% if filters.garage %}checked{% endif %}> Garage</label><label class="qc-check-filter"><input type="checkbox" name="furnished" value="1" {% if filters.furnished %}checked{% endif %}> Amueblada</label><label class="qc-check-filter"><input type="checkbox" name="garden" value="1" {% if filters.garden %}checked{% endif %}> Jardín</label></div></form></section>
<section class="qc-results"><div class="qc-results-head"><b>{{ totalResults if totalResults is defined else results|length }} propiedades</b><div><button type="button" class="qc-save-search" data-qc-save-search>☆ Guardar búsqueda</button><a href="/qcasa/mapa{% if queryString %}?{{ queryString }}{% endif %}">Ver mapa</a><a href="/qcasa/buscar">Limpiar filtros</a></div></div><div class="qc-card-grid">{% for p in results %}<article class="qc-property-card qc-result-card" data-qc-property data-id="{{ p.id }}" data-created-at="{{ p.createdAt or '' }}" data-title="{{ p.title }}" data-url="/qcasa/propiedad/{{ p.slug }}" data-image="{{ p.image }}" data-price="{{ money(p) }}" data-city="{{ p.city }}" data-category="{{ p.category }}" data-operation="{{ p.operation }}" data-area="{{ p.area|int }}" data-bedrooms="{{ p.bedrooms or 0 }}" data-bathrooms="{{ p.bathrooms or 0 }}"><a href="/qcasa/propiedad/{{ p.slug }}" class="qc-card-main"><div class="qc-property-photo"><img src="{{ p.image }}" alt="{{ p.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;"><span>{{ p.category }}</span><button type="button" class="qc-fav-btn" data-qc-favorite aria-label="Guardar en favoritos">♡</button>{% if p.videoUrl %}<em class="qc-video-badge">▶ Video</em>{% endif %}</div><div class="qc-property-body"><small>{{ p.operation }} · {{ p.department }}</small><h3>{{ p.title }}</h3><strong>{{ money(p) }}</strong><p>{{ p.city }} · {{ p.area|int }} m²{% if p.bedrooms %} · {{ p.bedrooms }} dorm.{% endif %}</p></div></a><div class="qc-card-tools"><button type="button" data-qc-compare>+ Comparar</button><a class="qc-share-card" target="_blank" rel="noopener" href="{{ p.shareWhatsApp }}">Compartir por WhatsApp</a></div></article>{% else %}<div class="qc-empty">No encontramos propiedades con esos filtros.</div>{% endfor %}</div>{% if pagination and pagination.totalPages > 1 %}<nav class="qc-pagination" aria-label="Páginas de resultados">{% if pagination.prev %}<a href="{{ pagination.prev }}">← Anterior</a>{% else %}<span></span>{% endif %}<strong>Página {{ pagination.page }} de {{ pagination.totalPages }}</strong>{% if pagination.next %}<a href="{{ pagination.next }}">Siguiente →</a>{% else %}<span></span>{% endif %}</nav>{% endif %}</section></main>
<script>(function(){const b=document.getElementById('qcMoreFilters'),p=document.getElementById('qcAdvancedFilters');if(b&&p)b.addEventListener('click',()=>{const o=p.classList.toggle('is-open');b.textContent=o?'Menos filtros −':'Más filtros +';});const u=new URL(location.href),since=Number(u.searchParams.get('qcNewSince')||0);if(since){u.searchParams.delete('qcNewSince');const cards=[...document.querySelectorAll('[data-qc-property]')];cards.forEach(c=>{const t=Date.parse(c.dataset.createdAt||'')||0;if(t<=since)c.hidden=true});const visible=cards.filter(c=>!c.hidden).length;const count=document.querySelector('.qc-results-head>b');if(count)count.textContent=visible+' propiedades nuevas';}})();</script>{% endblock %}