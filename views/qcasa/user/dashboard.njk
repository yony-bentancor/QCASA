{% extends 'qcasa/layout.njk' %}{% block qcbody %}
<main class="qc-user qc-user-refined"><header class="qc-user-head qc-user-head-refined"><div><span class="qc-kicker">MI QCASA</span><h1>Hola, {{ user.name }}</h1><p>Tus propiedades, favoritos, búsquedas y conversaciones en un solo lugar.</p></div><div class="qc-user-actions qc-user-actions-refined"><a class="qc-user-primary" href="/qcasa/mi-qcasa/publicar">+ Publicar propiedad</a>{% if whatsappQcasa %}<a class="qc-user-secondary" href="{{ whatsappQcasa }}" target="_blank" rel="noopener">WhatsApp QCASA</a>{% endif %}</div></header>
<section class="qc-user-quick"><button type="button" data-qc-open-favorites><b data-qc-dashboard-fav-count>0</b><span>Mis favoritos</span></button><button type="button" data-qc-open-compare><b data-qc-dashboard-compare-count>0</b><span>Comparar</span></button><a href="#misConsultas"><b>{{ myInquiries.length }}</b><span>Mis consultas</span></a><a href="#busquedasGuardadas"><b data-qc-dashboard-search-count>0</b><span>Mis búsquedas</span></a></section>
{% if unread %}<section class="qc-notice-bar qc-notice-refined"><div><span class="qc-notice-dot"></span><b>{{ unread }} notificación{{ 'es' if unread != 1 else '' }} nueva{{ 's' if unread != 1 else '' }}</b></div><form method="post" action="/qcasa/mi-qcasa/notificaciones/leer"><button>Marcar como leídas</button></form></section>{% endif %}
<section class="qc-personal-saved"><div><div class="qc-user-section-head qc-section-hierarchy"><div><h2>MIS FAVORITOS</h2><p>Propiedades guardadas</p></div></div><div class="qc-dashboard-favorites" data-qc-dashboard-favorites></div></div><aside id="busquedasGuardadas"><div class="qc-user-section-head qc-section-hierarchy"><div><h2>MIS BÚSQUEDAS</h2><p>Búsquedas guardadas</p></div></div><div class="qc-dashboard-searches" data-qc-dashboard-searches></div></aside></section>
<section class="qc-user-grid"><div class="qc-user-main"><div class="qc-user-section-head qc-section-hierarchy"><div><h2>MIS PUBLICACIONES</h2><p>Mis propiedades</p></div><span>{{ properties.length }} total</span></div>{% if properties.length %}<div class="qc-user-properties">{% for p in properties %}<article><div class="qc-user-property-image"><img src="{{ p.image }}" alt=""></div><div class="qc-user-property-copy"><small>{{ p.category }} · {{ p.city }}, {{ p.department }}</small><h3>{{ p.title }}</h3><strong>{{ money(p) }}</strong><p>{{ p.operation }} · {{ p.area | int }} m²</p></div><div class="qc-user-property-status"><span class="qc-state qc-state-{{ p.status | lower }}">{{ p.status }}</span>{% if p.status == 'Pendiente' %}<small>Esperando revisión del administrador.</small><a href="/qcasa/mi-qcasa/propiedades/{{ p.id }}/editar">Editar mientras está pendiente →</a>{% elif p.status == 'Publicada' %}<small>Tu propiedad está visible en QCASA.</small><a href="/qcasa/propiedad/{{ p.slug }}">Ver publicación →</a><a href="/qcasa/mi-qcasa/propiedades/{{ p.id }}/editar">Modificar publicación →</a>{% elif p.status == 'Rechazada' %}<small>{{ p.reviewNote or 'La publicación necesita cambios.' }}</small><a href="/qcasa/mi-qcasa/propiedades/{{ p.id }}/editar">Corregir publicación →</a>{% endif %}</div></article>{% endfor %}</div>{% else %}<div class="qc-empty">Todavía no publicaste ninguna propiedad.</div>{% endif %}</div>
<aside class="qc-user-notifications"><div class="qc-user-section-head qc-section-hierarchy"><div><h2>MIS NOTIFICACIONES</h2><p>Actividad reciente</p></div></div><div data-qc-search-alerts></div>{% if notifications.length %}{% for n in notifications %}<article class="qc-note qc-note-{{ n.type }} {% if not n.read %}is-unread{% endif %}"><b>{{ n.title }}</b><p>{{ n.message }}</p><small>{{ n.createdAt | replace('T',' ') | truncate(16, true, '') }}</small></article>{% endfor %}{% else %}<div class="qc-empty">No tenés notificaciones todavía.</div>{% endif %}</aside></section>
<section class="qc-my-inquiries" id="misConsultas"><div class="qc-user-section-head qc-section-hierarchy"><div><h2>MIS CONSULTAS</h2><p>Consultas y respuestas</p></div><span>{{ myInquiries.length }} total</span></div>{% if myInquiries.length %}<div class="qc-my-inquiry-list">{% for i in myInquiries %}<article><header><div><small>{{ i.status }}</small><h3>{{ i.propertyTitle }}</h3></div><time>{{ i.createdAt | replace('T',' ') | truncate(16, true, '') }}</time></header><div class="qc-conversation-message is-user"><small>Tu consulta</small><p>{{ i.message }}</p></div>{% if i.replies and i.replies.length %}{% for reply in i.replies %}<div class="qc-conversation-message is-qcasa"><small>QCASA · {{ reply.createdAt | replace('T',' ') | truncate(16, true, '') }}</small><p>{{ reply.message }}</p></div>{% endfor %}{% else %}<div class="qc-awaiting-reply">QCASA todavía no respondió esta consulta.</div>{% endif %}</article>{% endfor %}</div>{% else %}<div class="qc-empty">Todavía no tenés consultas asociadas a tu cuenta.</div>{% endif %}</section></main>
{% endblock %}