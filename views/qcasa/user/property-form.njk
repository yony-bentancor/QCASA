{% extends 'qcasa/layout.njk' %}{% block qcbody %}<main class="qc-admin qc-admin-form-page qc-user-publish-page"><a class="qc-back" href="/qcasa/mi-qcasa">← Volver a Mi QCASA</a><div class="qc-admin-head qc-publish-head"><div><span class="qc-kicker">{{ 'MODIFICAR PUBLICACIÓN ACTIVA' if mode=='published-edit' else ('CORREGIR PUBLICACIÓN' if mode=='edit' else 'PUBLICACIÓN PARA REVISIÓN') }}</span><h1>{{ 'Modificar publicación' if mode=='published-edit' else ('Editar propiedad' if mode=='edit' else 'Publicar mi propiedad') }}</h1><p>{% if mode=='published-edit' %}La publicación actual seguirá visible. Tus cambios irán al administrador y se aplicarán solamente si los aprueba.{% elif mode=='edit' %}Podés corregir los datos, fotos y video.{% else %}Completá los datos de tu propiedad. QCASA la revisará antes de publicarla.{% endif %}</p></div></div>{% if error %}<div class="qc-error qc-form-error">{{ error }}</div>{% endif %}
<form class="qc-property-form" method="post" enctype="multipart/form-data" action="{% if mode=='published-edit' %}/qcasa/mi-qcasa/propiedades/{{ property.id }}/cambios{% elif mode=='edit' %}/qcasa/mi-qcasa/propiedades/{{ property.id }}{% else %}/qcasa/mi-qcasa/propiedades{% endif %}">
<label class="qc-wide">Título<input name="title" value="{{ property.pendingChanges.title if mode=='published-edit' and property.pendingChanges else (property.title if property else '') }}" required></label>
<label>Tipo<select name="category">{% for c in categories %}<option value="{{ c }}" {% if property and property.category==c %}selected{% endif %}>{{ c }}</option>{% endfor %}</select></label>
<label>Operación<select name="operation"><option value="Venta" {% if property and property.operation=='Venta' %}selected{% endif %}>Venta</option><option value="Alquiler" {% if property and property.operation=='Alquiler' %}selected{% endif %}>Alquiler</option></select></label>
<label>Departamento<select name="department">{% for d in departments %}<option value="{{ d }}" {% if (property and property.department==d) or (not property and d=='Colonia') %}selected{% endif %}>{{ d }}</option>{% endfor %}</select></label>
<label>Ciudad / barrio / zona<input name="city" value="{{ property.pendingChanges.city if mode=='published-edit' and property.pendingChanges else (property.city if property else '') }}" required></label>
<label>Moneda<select name="currency"><option value="USD" {% if not property or property.currency=='USD' %}selected{% endif %}>USD</option><option value="UYU" {% if property and property.currency=='UYU' %}selected{% endif %}>UYU</option></select></label>
<label>Precio<input type="number" name="price" min="1" value="{{ property.pendingChanges.price if mode=='published-edit' and property.pendingChanges else (property.price if property else '') }}" required></label>
<label>Dormitorios<input type="number" name="bedrooms" min="0" value="{{ property.bedrooms if property else 0 }}"></label><label>Baños<input type="number" name="bathrooms" min="0" value="{{ property.bathrooms if property else 1 }}"></label><label>Superficie m²<input type="number" name="area" min="1" value="{{ property.area if property else '' }}" required></label><label>Teléfono de contacto<input name="contact" value="{{ property.contact if property else user.phone }}" required></label>
<label>Latitud para mapa<input type="number" step="any" name="lat" value="{{ property.lat if property and property.lat else '' }}" placeholder="-34.47"></label><label>Longitud para mapa<input type="number" step="any" name="lng" value="{{ property.lng if property and property.lng else '' }}" placeholder="-57.85"></label>
<label class="qc-check"><input type="checkbox" name="garage" {% if property and property.garage %}checked{% endif %}> Garage / cochera</label><label class="qc-check"><input type="checkbox" name="garden" {% if property and property.garden %}checked{% endif %}> Jardín</label><label class="qc-check"><input type="checkbox" name="furnished" {% if property and property.furnished %}checked{% endif %}> Amueblada</label>
<label class="qc-wide">Fotos<input type="file" name="photos" accept="image/*" multiple><small class="qc-field-help">Podés cargar hasta 8 imágenes.</small></label>
<label class="qc-wide">Video de la propiedad<input type="url" name="videoUrl" value="{{ property.pendingChanges.videoUrl if mode=='published-edit' and property.pendingChanges else (property.videoUrl if property else '') }}" placeholder="YouTube o URL directa de video"><small class="qc-field-help">Pegá un enlace de YouTube o un archivo MP4 público. QCASA lo mostrará en la ficha.</small></label>
{% if property and property.images and property.images.length %}<div class="qc-wide qc-photo-preview">{% for photo in property.images %}<img src="{{ photo }}" alt="Foto de la propiedad">{% endfor %}</div>{% endif %}
<label class="qc-wide">Descripción<textarea name="summary" rows="6" required>{{ property.pendingChanges.summary if mode=='published-edit' and property.pendingChanges else (property.summary if property else '') }}</textarea></label>
<div class="qc-wide qc-submit-review"><div><b>{{ 'Enviar cambios a aprobación' if mode=='published-edit' else ('Guardar cambios' if mode=='edit' else 'Antes de publicarse') }}</b><span>QCASA revisará la información, fotos y video antes de aplicar los cambios.</span></div><button>{{ 'Enviar cambios' if mode=='published-edit' else ('Guardar cambios' if mode=='edit' else 'Enviar a revisión') }}</button></div></form></main>{% endblock %}