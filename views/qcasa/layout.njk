{% extends 'layouts/base.njk' %}
{% block styles %}<link rel="stylesheet" href="/css/qcasa-bundle.css?v=51">{% endblock %}
{% block body %}
<div class="qc-page" id="qcTop"><header class="qc-nav qc-colonia-nav qc-nav-unified"><a class="qc-brand" href="/qcasa"><span class="qc-mark">Q</span><span class="qc-name">QCASA</span></a><button class="qc-mobile-menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-qc-mobile-menu><span></span><span></span><span></span></button><nav class="qc-main-nav" data-qc-main-nav><button class="qc-mobile-menu-close" type="button" aria-label="Cerrar menú" data-qc-mobile-close>×</button><a data-qc-nav="Venta" href="/qcasa/buscar?operation=Venta">Comprar</a><a data-qc-nav="Alquiler" href="/qcasa/buscar?operation=Alquiler">Alquilar</a><a data-qc-nav="Mapa" href="/qcasa/mapa">Mapa</a><button type="button" class="qc-contact-nav" data-qc-contact-open>Contacto</button><a data-qc-nav="Publicar" class="qc-publish-nav qc-publish-plain" href="{{ '/qcasa/admin/propiedades/nueva' if session.qcasaAdmin else ('/qcasa/mi-qcasa/publicar' if session.qcasaUser else '/qcasa/registro?publicar=1') }}">Publicar propiedad</a><form class="qc-currency-switch" method="post" action="/qcasa/moneda"><select name="currencyMode" onchange="this.form.submit()" aria-label="Moneda"><option value="USD" {% if session.qcasaCurrency != 'UYU' %}selected{% endif %}>USD</option><option value="UYU" {% if session.qcasaCurrency == 'UYU' %}selected{% endif %}>UYU</option></select></form>{% if session.qcasaAdmin %}<a class="qc-account-link" href="/qcasa/admin">Admin</a><form class="qc-header-logout" method="post" action="/qcasa/salir"><button type="submit">Salir</button></form>{% elif session.qcasaUser %}<a class="qc-account-link" href="/qcasa/mi-qcasa">Mi QCASA</a><form class="qc-header-logout" method="post" action="/qcasa/salir"><button type="submit">Salir</button></form>{% else %}<a href="/qcasa/ingresar" class="qc-login">Ingresar</a>{% endif %}</nav></header><div class="qc-mobile-menu-backdrop" data-qc-mobile-backdrop></div>
{% block qcbody %}{% endblock %}
<footer class="qc-footer qc-footer-minimal"><div><b>QCASA</b><small>Comprar · Alquilar · Mapa · Contacto · Publicar</small></div><div class="qc-footer-studio"><a href="{{ links.estudioqr }}">Estudio QR</a></div><small class="qc-footer-copyright">© 2026 QCASA</small><a class="qc-back-to-top" href="#qcTop" data-qc-back-top>↑ Volver arriba</a></footer><button class="qc-favorites-fab" type="button" data-qc-open-favorites hidden aria-label="Abrir favoritos">♡ <span data-qc-fav-count>0</span></button><div class="qc-drawer-backdrop" data-qc-drawer-backdrop></div><aside class="qc-saved-drawer" data-qc-saved-drawer><button class="qc-drawer-close" type="button" data-qc-close-drawer>×</button><div data-qc-drawer-content></div></aside><div class="qc-compare-bar" data-qc-compare-bar hidden><span><b data-qc-compare-count>0</b> <span class="qc-compare-label">seleccionadas</span></span><button type="button" data-qc-open-compare>Comparar</button><button type="button" data-qc-clear-compare>Limpiar</button></div>
<div class="qc-contact-modal" data-qc-contact-modal hidden><div class="qc-contact-modal-backdrop" data-qc-contact-close></div><section class="qc-contact-modal-card" role="dialog" aria-modal="true" aria-labelledby="qcContactTitle"><button type="button" class="qc-contact-modal-close" data-qc-contact-close aria-label="Cerrar">×</button><span class="qc-kicker">CONTACTO QCASA</span><h2 id="qcContactTitle">Hablemos</h2><p class="qc-contact-intro">Contanos brevemente qué necesitás y te respondemos a la brevedad.</p><form method="post" action="/qcasa/contacto"><label>Nombre<input name="name" required></label><label>Teléfono<input name="phone" required></label><label>Email<input type="email" name="email"></label><label>Motivo<select name="reason"><option>Comprar</option><option>Alquilar</option><option>Publicar una propiedad</option><option>Consulta general</option><option>Otro</option></select></label><label class="qc-contact-message">Mensaje<textarea name="message" rows="3" required></textarea></label><button type="submit">Enviar consulta</button></form></section></div></div>
<script src="/js/qcasa-experience.js" defer></script><script src="/js/qcasa-mobile-nav.js?v=51" defer></script><script src="/js/qcasa-contact.js" defer></script><script>(function(){const path=location.pathname,qs=new URLSearchParams(location.search);let key='';if(path==='/qcasa/mapa')key='Mapa';else if(path==='/qcasa/buscar')key=qs.get('operation')||'';else if(path==='/qcasa/mi-qcasa/publicar'||path==='/qcasa/admin/propiedades/nueva')key='Publicar';document.querySelectorAll('[data-qc-nav]').forEach(a=>a.classList.toggle('is-active',a.dataset.qcNav===key));})();</script>
{% endblock %}