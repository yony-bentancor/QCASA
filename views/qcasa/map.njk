{% extends 'qcasa/layout.njk' %}{% block qcbody %}<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><main class="qc-map-page qc-public-surface"><section class="qc-map-head"><div><span class="qc-kicker">EXPLORAR</span><h1>Propiedades en el mapa</h1><p>Mové el mapa o acercate: el resultado se actualiza según el área visible.</p></div><div class="qc-map-head-actions qc-map-view-actions"><a class="qc-map-list-btn" href="/qcasa/buscar{% if queryString %}?{{ queryString }}{% endif %}"><span>☷</span> Ver listado</a><a class="qc-map-filter-btn" href="/qcasa/buscar{% if queryString %}?{{ queryString }}{% endif %}"><span>⌁</span> Filtros avanzados</a></div></section><section class="qc-map-shell"><div id="qcPropertyMap" class="qc-property-map"></div><aside class="qc-map-side"><div class="qc-map-side-head"><b id="qcMapVisibleCount">{{ results.length }} propiedades en esta zona</b><span>Mové o acercá el mapa para refinar</span></div><div id="qcMapSelected" class="qc-map-selected"><div class="qc-map-placeholder"><b>Explorá el mapa</b><span>El contador y el listado responden al área visible.</span></div></div><div id="qcMapVisibleList" class="qc-map-visible-list"></div></aside></section></main><script>window.QCASA_MAP_PROPERTIES={{ mapProperties|safe }};window.QCASA_MAP_FOCUS="{{ focusProperty or '' }}";</script><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script src="/js/qcasa-map.js"></script>{% endblock %}