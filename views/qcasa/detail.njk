{% extends 'qcasa/layout.njk' %}{% block qcbody %}<main class="qc-detail qc-public-surface qc-detail-premium"><div class="qc-detail-topbar"><a class="qc-back" href="/qcasa/buscar">← Volver a propiedades</a><div><button type="button" class="qc-share-btn qc-detail-fav" data-qc-detail-favorite data-id="{{ property.id }}" data-title="{{ property.title }}" data-url="/qcasa/propiedad/{{ property.slug }}" data-image="{{ property.image }}" data-price="{{ money(property) }}" data-city="{{ property.city }}" data-category="{{ property.category }}" data-operation="{{ property.operation }}" data-area="{{ property.area|int }}" data-bedrooms="{{ property.bedrooms or 0 }}" data-bathrooms="{{ property.bathrooms or 0 }}">♡ Guardar</button><button type="button" class="qc-share-btn" data-qc-detail-compare data-id="{{ property.id }}" data-title="{{ property.title }}" data-url="/qcasa/propiedad/{{ property.slug }}" data-image="{{ property.image }}" data-price="{{ money(property) }}" data-city="{{ property.city }}" data-category="{{ property.category }}" data-operation="{{ property.operation }}" data-area="{{ property.area|int }}" data-bedrooms="{{ property.bedrooms or 0 }}" data-bathrooms="{{ property.bathrooms or 0 }}">+ Comparar</button><button type="button" class="qc-share-btn" data-qc-share-native>Compartir</button>{% if whatsappQcasa %}<a href="{{ whatsappQcasa }}" target="_blank" rel="noopener" class="qc-contact-wa">Consultar por WhatsApp</a>{% endif %}</div></div>
<nav class="qc-detail-anchor-nav"><a href="#fotos">Fotos</a><a href="#caracteristicas">Características</a><a href="#descripcion">Descripción</a><a href="#ubicacion">Ubicación</a><a href="#consultar">Consultar</a></nav><section class="qc-detail-grid" id="fotos"><div class="qc-detail-gallery"><button class="qc-gallery-main" type="button" data-qc-gallery-open="0"><img src="{{ property.image }}" alt="{{ property.title }}"><span>{{ property.category }}</span>{% if property.videoUrl %}<em class="qc-video-badge">▶ Video disponible</em>{% endif %}<b>QCASA</b><i>Ver fotos</i></button>{% if property.images and property.images.length > 1 %}<div class="qc-gallery-thumbs">{% for img in property.images %}{% if loop.index0 < 3 %}<button type="button" data-qc-gallery-open="{{ loop.index0 }}"><img src="{{ img }}" alt="Foto {{ loop.index }}"></button>{% endif %}{% endfor %}</div>{% endif %}<script type="application/json" data-qc-gallery-images>{{ galleryImages | safe }}</script></div><div class="qc-detail-info"><span class="qc-kicker">{{ property.operation }} · {{ property.department }}</span><h1>{{ property.title }}</h1><strong class="qc-price">{{ money(property) }}</strong><p class="qc-location">{{ property.city }}</p><div class="qc-features" id="caracteristicas"><span>{{ property.area|int }} m²</span>{% if property.bedrooms %}<span>{{ property.bedrooms }} dormitorios</span>{% endif %}{% if property.bathrooms %}<span>{{ property.bathrooms }} baños</span>{% endif %}{% if property.garage %}<span>Garage</span>{% endif %}{% if property.garden %}<span>Jardín</span>{% endif %}</div><p class="qc-description" id="descripcion">{{ property.summary }}</p><div class="qc-id">Referencia {{ property.id }}</div></div></section>
{% if property.videoUrl %}<section class="qc-property-video"><div><span class="qc-kicker">RECORRIDO</span><h2>Conocé la propiedad en video</h2></div>{% if 'youtube.com/embed/' in property.videoUrl %}<iframe src="{{ property.videoUrl }}" title="Video de {{ property.title }}" allowfullscreen></iframe>{% else %}<video controls preload="metadata" poster="{{ property.image }}"><source src="{{ property.videoUrl }}">Tu navegador no puede reproducir este video.</video>{% endif %}</section>{% endif %}
<section class="qc-detail-lower"><div class="qc-property-sheet"><span class="qc-kicker">FICHA DE LA PROPIEDAD</span><h2>Información y ubicación</h2><div class="qc-spec-grid"><div><small>Operación</small><b>{{ property.operation }}</b></div><div><small>Tipo</small><b>{{ property.category }}</b></div><div><small>Superficie</small><b>{{ property.area|int }} m²</b></div><div><small>Dormitorios</small><b>{{ property.bedrooms or '—' }}</b></div><div><small>Baños</small><b>{{ property.bathrooms or '—' }}</b></div><div><small>Zona</small><b>{{ property.city }}</b></div></div>{% if property.lat and property.lng %}<div class="qc-detail-map-wrap" id="ubicacion"><iframe title="Mapa" loading="lazy" src="https://www.google.com/maps?q={{ property.lat }},{{ property.lng }}&z=14&output=embed"></iframe><a href="/qcasa/mapa?property={{ property.id }}">Ver esta propiedad en el mapa interactivo →</a></div>{% endif %}</div>
<aside class="qc-contact-box qc-contact-redesign" id="consultar"><div class="qc-contact-intro"><span class="qc-kicker">CONSULTAR</span><h2>¿Querés saber más?</h2><p>Dejanos tus datos y te acompañamos con la consulta sobre esta propiedad.</p><small>Respuesta personalizada · Tus datos se usan únicamente para gestionar esta consulta.</small></div>{% if consulted %}<div class="qc-success">✓ Consulta recibida.</div>{% else %}<form class="qc-contact-form" action="/qcasa/propiedad/{{ property.slug }}/consulta" method="post"><div class="qc-contact-fields"><input name="name" autocomplete="name" value="{{ qcasaUser.name if qcasaUser else '' }}" placeholder="Nombre" required><input name="phone" type="tel" inputmode="tel" autocomplete="tel" value="{{ qcasaUser.phone if qcasaUser else '' }}" placeholder="Teléfono" required><input type="email" name="email" autocomplete="email" value="{{ qcasaUser.email if qcasaUser else '' }}" placeholder="Email"><textarea name="message" rows="3" placeholder="Mensaje">{% if qcasaUser %}Me interesa esta propiedad. Quisiera recibir más información.{% endif %}</textarea></div><button class="qc-send-consult">{% if qcasaUser %}Me interesa{% else %}Enviar consulta{% endif %} <span>→</span></button></form>{% endif %}</aside></section>{% if similar and similar.length %}<section class="qc-similar"><div class="qc-section-head"><div><span class="qc-kicker">TAMBIÉN PODRÍA INTERESARTE</span><h2>Propiedades similares</h2></div></div><div class="qc-card-grid">{% for p in similar %}<a class="qc-property-card" href="/qcasa/propiedad/{{ p.slug }}"><div class="qc-property-photo"><img src="{{ p.image }}" alt="{{ p.title }}"><span>{{ p.category }}</span></div><div class="qc-property-body"><small>{{ p.operation }} · {{ p.city }}</small><h3>{{ p.title }}</h3><strong>{{ money(p) }}</strong><p>{{ p.area|int }} m²{% if p.bedrooms %} · {{ p.bedrooms }} dorm.{% endif %}</p></div></a>{% endfor %}</div></section>{% endif %}<div class="qc-gallery-modal" data-qc-gallery-modal hidden><button type="button" data-qc-gallery-close>×</button><button type="button" data-qc-gallery-prev>‹</button><img data-qc-gallery-view alt="Galería"><button type="button" data-qc-gallery-next>›</button><span data-qc-gallery-counter></span></div></main>{% endblock %}