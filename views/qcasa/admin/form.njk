{% extends 'qcasa/layout.njk' %}{% block qcbody %}<main class="qc-admin qc-admin-form-page"><div class="qc-admin-head"><div><span class="qc-kicker">ADMINISTRACIÓN QCASA</span><h1>{{ 'Editar propiedad' if property else 'Cargar propiedad' }}</h1><a class="qc-back" href="/qcasa/admin/propiedades">← Volver a propiedades</a></div>{% include 'qcasa/admin/_nav.njk' %}</div>
<form class="qc-property-form" method="post" enctype="multipart/form-data" action="{{ '/qcasa/admin/propiedades/' + property.id if property else '/qcasa/admin/propiedades' }}"><label class="qc-wide">Título<input name="title" value="{{ property.title if property else '' }}" required></label><label>Tipo<select name="category">{% for c in categories %}<option value="{{ c }}" {% if property and property.category==c %}selected{% endif %}>{{ c }}</option>{% endfor %}</select></label><label>Operación<select name="operation"><option value="Venta" {% if property and property.operation=='Venta' %}selected{% endif %}>Venta</option><option value="Alquiler" {% if property and property.operation=='Alquiler' %}selected{% endif %}>Alquiler</option></select></label><label>Departamento<select name="department">{% for d in departments %}<option value="{{ d }}" {% if (property and property.department==d) or (not property and d=='Colonia') %}selected{% endif %}>{{ d }}</option>{% endfor %}</select></label><label>Ciudad / barrio<input name="city" value="{{ property.city if property else '' }}" required></label><label>Moneda<select name="currency"><option value="USD" {% if not property or property.currency=='USD' %}selected{% endif %}>USD</option><option value="UYU" {% if property and property.currency=='UYU' %}selected{% endif %}>UYU</option></select></label><label>Precio<input type="number" name="price" value="{{ property.price if property else '' }}" required></label><label>Dormitorios<input type="number" name="bedrooms" value="{{ property.bedrooms if property else 0 }}"></label><label>Baños<input type="number" name="bathrooms" value="{{ property.bathrooms if property else 1 }}"></label><label>Superficie m²<input type="number" name="area" value="{{ property.area if property else '' }}" required></label><label>Teléfono<input name="contact" value="{{ property.contact if property else '' }}"></label><label>Latitud<input type="number" step="any" name="lat" value="{{ property.lat if property and property.lat else '' }}"></label><label>Longitud<input type="number" step="any" name="lng" value="{{ property.lng if property and property.lng else '' }}"></label><label class="qc-check"><input type="checkbox" name="garage" {% if property and property.garage %}checked{% endif %}> Garage</label><label class="qc-check"><input type="checkbox" name="garden" {% if property and property.garden %}checked{% endif %}> Jardín</label><label class="qc-check"><input type="checkbox" name="furnished" {% if property and property.furnished %}checked{% endif %}> Amueblada</label><label class="qc-wide">Fotos<input type="file" name="photos" accept="image/*" multiple></label><label class="qc-wide">Video<input type="url" name="videoUrl" value="{{ property.videoUrl if property else '' }}" placeholder="YouTube o URL MP4"><small class="qc-field-help">Se revisa junto con la publicación.</small></label>{% if property and property.images and property.images.length %}<div class="qc-wide qc-photo-preview">{% for photo in property.images %}<img src="{{ photo }}" alt="Foto">{% endfor %}</div>{% endif %}<label class="qc-wide">Descripción<textarea name="summary" rows="5" required>{{ property.summary if property else '' }}</textarea></label><label class="qc-check qc-wide"><input type="checkbox" name="featured" {% if property and property.featured %}checked{% endif %}> Destacada</label><div class="qc-wide"><button>Guardar propiedad</button></div></form></main>{% endblock %}