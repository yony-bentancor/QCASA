{% extends 'qcasa/layout.njk' %}
{% block qcbody %}
<main class="qc-admin">
  <div class="qc-admin-head">
    <div><span class="qc-kicker">ADMINISTRACIÓN QCASA</span><h1>Configuración</h1><p>Parámetros del MVP y comunicaciones.</p></div>
    {% include 'qcasa/admin/_nav.njk' %}
  </div>

  <section class="qc-settings-grid">
    <form class="qc-admin-panel qc-settings-form" method="post" action="/qcasa/admin/configuracion">
      <div class="qc-panel-head"><h2>Parámetros de QCASA</h2><span>demo editable</span></div>

      <div class="qc-settings-body">
        <label>Cotización UYU por USD
          <input type="number" step="0.01" min="1" name="uyuPerUsd" value="{{ settings.uyuPerUsd }}">
          <small>Se usa para mostrar precios en ambas monedas.</small>
        </label>

        <label>Visualización de moneda por defecto
          <select name="currencyDisplay">
            
            <option value="USD" {% if settings.currencyDisplay=='USD' %}selected{% endif %}>Solo USD</option>
            <option value="UYU" {% if settings.currencyDisplay=='UYU' %}selected{% endif %}>Solo UYU</option>
          </select>
        </label>

        <label>Días para considerar una publicación sin movimiento
          <input type="number" min="1" name="staleDays" value="{{ settings.staleDays }}">
        </label>

        <label>Máximo de fotos por carga
          <input type="number" min="1" max="20" name="maxPhotos" value="{{ settings.maxPhotos }}">
        </label>

        <label>Destacadas en portada
          <input type="number" min="1" max="12" name="featuredLimit" value="{{ settings.featuredLimit }}">
        </label>

        <label>Email de contacto
          <input type="email" name="contactEmail" value="{{ settings.contactEmail }}">
        </label>

        <label>Teléfono de contacto
          <input name="contactPhone" value="{{ settings.contactPhone }}">
        </label>

        <label>Texto de marca / pie
          <input name="footerText" value="{{ settings.footerText }}">
        </label>

        <fieldset class="qc-departments">
          <legend>Departamentos habilitados para publicar</legend>
          {% for d in departments %}
          <label>
            <input type="checkbox" name="activeDepartments" value="{{ d }}" {% if d in settings.activeDepartments %}checked{% endif %}>
            {{ d }}
          </label>
          {% endfor %}
        </fieldset>

        <button class="qc-save-settings">Guardar configuración</button>
      </div>
    </form>

    <div class="qc-admin-panel qc-communications">
      <div class="qc-panel-head"><h2>Comunicación masiva</h2><span>notificación interna</span></div>

      <form method="post" action="/qcasa/admin/comunicaciones">
        <label>Título<input name="title" required placeholder="Ej: Novedades de QCASA"></label>
        <label>Mensaje<textarea name="message" rows="5" required></textarea></label>

        <label>Destinatarios
          <select name="audience">
            <option value="all">Todos los usuarios activos</option>
            <option value="pending">Con publicaciones pendientes</option>
            <option value="published">Con propiedades publicadas</option>
            <option value="rejected">Con propiedades rechazadas</option>
          </select>
        </label>

        <label>Departamento
          <select name="department">
            <option value="">Todos</option>
            {% for d in departments %}<option value="{{ d }}">{{ d }}</option>{% endfor %}
          </select>
        </label>

        <button>Enviar notificación</button>
      </form>

      <div class="qc-comm-history">
        <h3>Últimos envíos</h3>
        {% if communications.length %}
          {% for c in communications %}
          <article>
            <b>{{ c.title }}</b>
            <span>{{ c.recipientCount }} destinatarios · {{ c.audience }}</span>
            <small>{{ c.createdAt | replace('T',' ') | truncate(16,true,'') }}</small>
          </article>
          {% endfor %}
        {% else %}
          <p>Todavía no hay comunicaciones masivas.</p>
        {% endif %}
      </div>
    </div>
  </section>
</main>
{% endblock %}
