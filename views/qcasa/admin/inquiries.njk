{% extends 'qcasa/layout.njk' %}{% block qcbody %}
<main class="qc-admin"><div class="qc-admin-head"><div><span class="qc-kicker">ADMINISTRACIÓN QCASA</span><h1>Consultas</h1><p>Primero lo pendiente. El historial queda siempre disponible.</p></div>{% include 'qcasa/admin/_nav.njk' %}</div>
<section class="qc-inquiry-summary"><a class="{{ 'active' if selected=='Pendientes' }}" href="/qcasa/admin/consultas?status=Pendientes"><b>{{ counts.Pendientes }}</b><span>Pendientes</span></a><a class="{{ 'active' if selected=='Nueva' }}" href="/qcasa/admin/consultas?status=Nueva"><b>{{ counts.Nueva }}</b><span>Nuevas</span></a><a class="{{ 'active' if selected=='Contactado' }}" href="/qcasa/admin/consultas?status=Contactado"><b>{{ counts.Contactado }}</b><span>Contactadas</span></a><a class="{{ 'active' if selected=='Visita' }}" href="/qcasa/admin/consultas?status=Visita"><b>{{ counts.Visita }}</b><span>Visitas</span></a><a class="{{ 'active' if selected=='Negociación' }}" href="/qcasa/admin/consultas?status=Negociación"><b>{{ counts.Negociación }}</b><span>Negociación</span></a><a class="{{ 'active' if selected=='Cerrada' }}" href="/qcasa/admin/consultas?status=Cerrada"><b>{{ counts.Cerrada }}</b><span>Cerradas</span></a><a class="{{ 'active' if selected=='Todos' }}" href="/qcasa/admin/consultas?status=Todos"><b>{{ counts.Todos }}</b><span>Historial</span></a></section>
<section class="qc-admin-panel"><div class="qc-panel-head"><h2>{{ selected }}</h2><span>{{ inquiries.length }} consultas visibles</span></div><div class="qc-inquiry-list">{% for i in inquiries %}<article id="{{ i.id }}" class="qc-inquiry-row qc-status-{{ i.status|lower }}"><div class="qc-inquiry-copy"><small>{{ i.id }} · {{ i.status }}</small><b>{{ i.propertyTitle }}</b><span>{{ i.name }} · {{ i.phone }}{% if i.email %} · {{ i.email }}{% endif %}</span><p>{{ i.message }}</p>{% if i.replies and i.replies.length %}<div class="qc-admin-replies"><small>RESPUESTAS QCASA</small>{% for reply in i.replies %}<div><p>{{ reply.message }}</p><time>{{ reply.createdAt | replace('T',' ') | truncate(16, true, '') }}</time></div>{% endfor %}</div>{% if not i.userId and i.phone %}{% set lastReply = i.replies[i.replies.length - 1] %}<a class="qc-reply-whatsapp" href="https://wa.me/598{{ i.phone | replace(' ','') | replace('-','') | replace('0','',1) }}?text={{ ('Hola ' + i.name + '. Te respondemos desde QCASA por tu consulta sobre ' + i.propertyTitle + ': ' + lastReply.message) | urlencode }}" target="_blank" rel="noopener">Enviar última respuesta por WhatsApp →</a>{% endif %}{% endif %}<details class="qc-admin-reply"><summary>Responder consulta</summary><form method="post" action="/qcasa/admin/consultas/{{ i.id }}/responder"><textarea name="message" rows="3" placeholder="Escribí la respuesta que verá el cliente en Mi QCASA..." required></textarea><button type="submit">Guardar respuesta</button><small>Quedará visible en Mi QCASA. Más adelante puede complementarse con email y WhatsApp.</small></form></details></div><div class="qc-inquiry-actions"><form method="post" action="/qcasa/admin/consultas/{{ i.id }}/estado"><label>Estado<select name="status" onchange="this.form.submit()">{% for s in statuses %}<option value="{{ s }}" {% if i.status==s %}selected{% endif %}>{{ s }}</option>{% endfor %}</select></label></form><div class="qc-whatsapp-stack">{% if i.whatsappInterested %}<a href="{{ i.whatsappInterested }}" target="_blank">WhatsApp interesado</a>{% endif %}{% if i.whatsappOwner %}<a href="{{ i.whatsappOwner }}" target="_blank">WhatsApp propietario</a>{% endif %}</div></div></article>{% else %}<div class="qc-empty">No hay consultas en este estado.</div>{% endfor %}</div></section></main>{% endblock %}