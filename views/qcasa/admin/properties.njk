{% extends 'qcasa/layout.njk' %}{% block qcbody %}<main class="qc-admin"><div class="qc-admin-head"><div><span class="qc-kicker">ADMINISTRACIÓN QCASA</span><h1>Propiedades</h1><p>Toda la cartera, independientemente del estado.</p></div>{% include 'qcasa/admin/_nav.njk' %}</div>
<section class="qc-property-status-tabs">{% for key,label in [['Todos','Todas'],['Publicada','Publicadas'],['Pendiente','Pendientes'],['Rechazada','Rechazadas'],['Borrador','Borradores'],['Cambios','Cambios'],['Videos','Con video']] %}<a class="{{ 'is-active' if selected==key }}" href="/qcasa/admin/propiedades?status={{ key }}"><b>{{ counts[key] }}</b><span>{{ label }}</span></a>{% endfor %}</section>
<section class="qc-admin-panel"><div class="qc-panel-head"><h2>{{ selected }}</h2><a href="/qcasa/admin/propiedades/nueva">+ Cargar propiedad</a></div><div class="qc-admin-property-list">{% for p in properties %}<article class="qc-admin-property-row">{% if p.status == 'Publicada' %}<a class="qc-admin-property-public" href="/qcasa/propiedad/{{ p.slug }}">{% else %}<div class="qc-admin-property-public qc-admin-property-static">{% endif %}<img src="{{ p.image }}" alt="{{ p.title }}"><div><small>{{ p.id }} · {{ p.status }}{% if p.changeStatus=='Pendiente' %} · CAMBIO PENDIENTE{% endif %}</small><b>{{ p.title }}</b><span>{{ p.operation }} · {{ p.category }} · {{ p.city }}</span><div class="qc-quality-mini"><b>{{ p.quality.score }}% completa</b><span>{% if p.quality.missing %}Falta: {{ p.quality.missing }}{% else %}Lista para destacar{% endif %}</span></div></div>{% if p.status == 'Publicada' %}</a>{% else %}</div>{% endif %}
<div class="qc-admin-property-actions">{% if p.status == 'Publicada' %}<a href="/qcasa/propiedad/{{ p.slug }}">Ver publicación</a>{% else %}<form method="post" action="/qcasa/admin/propiedades/{{ p.id }}/publicar"><button class="qc-admin-publish" type="submit">Publicar</button></form>{% endif %}<a href="/qcasa/admin/propiedades/{{ p.id }}/editar">Modificar</a><form class="qc-admin-status-form" method="post" action="/qcasa/admin/propiedades/{{ p.id }}/estado"><select name="status" aria-label="Cambiar estado" onchange="this.form.submit()"><option value="Borrador" {% if p.status=='Borrador' %}selected{% endif %}>Borrador</option><option value="Pendiente" {% if p.status=='Pendiente' %}selected{% endif %}>Pendiente</option><option value="Publicada" {% if p.status=='Publicada' %}selected{% endif %}>Publicada</option><option value="Rechazada" {% if p.status=='Rechazada' %}selected{% endif %}>Rechazada</option></select></form></div></article>{% else %}<div class="qc-empty">No hay propiedades en este estado.</div>{% endfor %}</div></section></main>{% endblock %}