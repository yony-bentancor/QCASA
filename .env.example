PORT=3002
NODE_ENV=development
SESSION_SECRET=qcasa-cambiar-esta-clave
# Enlace "Estudio QR" del pie de página
ESTUDIOQR_URL=http://localhost:3000

# Modo demo (datos en memoria y usuarios demo)
DEMO_MODE=true

# MongoDB (infraestructura preparada; los repositorios siguen en modo demo)
USE_MONGO=false
MONGO_URI=
ALLOW_MONGO_SEED=false
ALLOW_NONTEST_SEED=false

# Email opcional. Si queda vacío, las consultas se guardan igual y no se envía correo.
QCASA_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Datos reales ----
# Con USE_MONGO=true + MONGO_URI los datos se guardan en MongoDB Atlas (la primera vez se cargan los datos de muestra).
# Ejemplo: mongodb+srv://qcasa_user:CLAVE@estudioqr.maq9kij.mongodb.net/qcasa?retryWrites=true&w=majority&appName=estudioqr
# Contraseña del administrador (obligatoria con datos reales; reemplaza la de demostración)
QCASA_ADMIN_PASSWORD=
# QCASA_ADMIN_EMAIL=admin@qcasa.uy

# Cloudflare R2: fotos de las propiedades (bucket privado, mismas claves que QPROPIEDADES)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=estudioqr-archivos
R2_PREFIX=qcasa/
