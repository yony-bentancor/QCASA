PORT=3002
NODE_ENV=development
SESSION_SECRET=qcasa-cambiar-esta-clave
# Enlace "Estudio QR" del pie de página
ESTUDIOQR_URL=http://localhost:3000

# Modo demo (datos en memoria y usuarios demo)
DEMO_MODE=true

# MongoDB (infraestructura preparada; los repositorios siguen en modo demo)
USE_MONGO=false
MONGO_URI=
ALLOW_MONGO_SEED=false
ALLOW_NONTEST_SEED=false

# Email opcional. Si queda vacío, las consultas se guardan igual y no se envía correo.
QCASA_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
